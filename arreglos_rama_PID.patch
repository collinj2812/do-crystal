+def test_kcu_identificado_reproduce_las_constantes():
+    Kcu, Pu = plant.identificar_Kcu()
+    assert Kcu == pytest.approx(plant.KCU_SIM["Kcu_bar_C"], rel=0.02)
+    assert Pu == pytest.approx(plant.KCU_SIM["Pu_min"], rel=0.05)
+
