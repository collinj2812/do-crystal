+    "# # 05 · Control PID Dinámico Integrado (A3110 + Tren NPT-3 Áreas 2000–3000–6000)\n",
+    "# Integra: (1) Lazo abierto (+/-, con y sin ruido), (2) Lazo cerrado y consistencia estacionaria,\n",
+    "# (3) Cambios de consigna (IMC ε, ponderación β y ruido), (4) Estabilidad Routh-Hurwitz/Hopf y Frente de Pareto,\n",
+    "# y (Parte B) Subsistema de dilución AIT 3105 -> FFIC 3102 -> FIRC 3103 + Purga AIC 3255.\n",
+    "\n",
+    "# %%\n",
+    "import sys, os\n",
+    "sys.path.insert(0, os.path.abspath(\"..\"))\n",
+    "import numpy as np, pandas as pd, matplotlib.pyplot as plt\n",
+    "from msmpr_core.params import make_params\n",
+    "from msmpr_core.plant import Plant, simulate, simulate_plant_npt3_calibrated\n",
+    "from msmpr_core import control as C\n",
+    "from msmpr_core.control import (\n",
+    "    ConsignaVariable, Ruido, imc_pi, iae, metricas_consigna, sigma_ventana, routh_hopf_analysis\n",
+    ")\n",
+    "\n",
+    "os.makedirs(\"../docs/fig\", exist_ok=True)\n",
+    "plt.rcParams.update({\"figure.dpi\": 110, \"axes.grid\": True, \"grid.alpha\": 0.25})\n",
+    "\n",
+    "# Estado estacionario nominal A3110 y sintonía base\n",
+    "p = make_params()\n",
+    "pl = Plant(p)\n",
+    "x0, u0, d0 = pl.steady_state(alpha=0.25)\n",
+    "m0 = pl.metrics(x0, u0, d0)\n",
+    "q0, qs0 = u0[\"Q_dil_cmd\"], d0[\"Q_stock\"]\n",
+    "R0 = q0 / qs0\n",
+    "DT, TP, H_OL = 5.0, 3600.0, 18 * 3600\n",
+    "tun, info = C.autotune(pl, x0, u0, d0, dt_s=DT)\n",
+    "sp = {\"T\": x0[1], \"V\": x0[0], \"rho\": 0.0}\n",
+    "RUIDO = Ruido(seed=7, dt=DT, tc=600.0)\n",
+    "\n",
+    "# Configuración de 12 escenarios bidireccionales (+/-) y realización con ruido\n",
+    "VARS = {\n",
+    "    \"Q_stock\": (\"Q_stock\", \"rel\", 0.10),\n",
+    "    \"T_feed\": (\"T alim.\", \"add\", 5.0),\n",
+    "    \"CP_stock\": (\"ClO4 alim.\", \"rel\", 0.25),\n",
+    "    \"C_stock\": (\"KNO3 alim.\", \"rel\", 0.05),\n",
+    "    \"T_dil\": (\"T agua dil.\", \"add\", 10.0),\n",
+    "    \"valve_gain\": (\"Válvula dil.\", \"rel\", 0.20),\n",
+    "}\n",
+    "COLV = dict(zip(VARS, [\"tab:blue\", \"tab:red\", \"tab:green\", \"tab:purple\", \"tab:orange\", \"tab:brown\"]))\n",
+    "ESC, COL = {}, {\"Solo ruido\": \"k\"}\n",
+    "for k, (lab, kind, mag) in VARS.items():\n",
+    "    for sg in (+1, -1):\n",
+    "        nom = f\"{lab} {sg*mag*100:+.0f} %\" if kind == \"rel\" else f\"{lab} {sg*mag:+.0f} °C\"\n",
+    "        ESC[nom] = (k, kind, mag, sg)\n",
+    "        COL[nom] = COLV[k]\n",
+    "AUM = [n for n, v in ESC.items() if v[3] > 0]\n",
+    "DIS = [n for n, v in ESC.items() if v[3] < 0]\n",
+    "\n",
+    "def hacer_dist(key, kind, mag, signo, ruido=None):\n",
+    "    def f(t):\n",
+    "        d = dict(d0)\n",
+    "        if t >= TP:\n",
+    "            d[key] = d.get(key, 1.0) * (1.0 + signo * mag) if kind == \"rel\" else d[key] + signo * mag\n",
+    "        return ruido(d, t) if ruido is not None else d\n",
+    "    return f\n",
+    "\n",
+    "DIST = {n: hacer_dist(*v) for n, v in ESC.items()}\n",
+    "DIST_R = {n: hacer_dist(*v, ruido=RUIDO) for n, v in ESC.items()}\n",
+    "DIST_R[\"Solo ruido\"] = lambda t: RUIDO(dict(d0), t)\n",
+    "\n",
+    "def lazo_abierto(dist, H=H_OL, dt=DT, log=12):\n",
+    "    return simulate(pl, x0, H, dt, lambda t, x, pl_: u0, disturbance=dist, log_every=log)\n",
+    "\n",
+    "def lazo_cerrado(dist, H=H_OL, dt=DT, log=12, tuning=tun, enabled=(\"T\", \"V\", \"ratio\"), consigna=None):\n",
+    "    qsf = (lambda t: dist(t)[\"Q_stock\"]) if dist is not None else (lambda t: qs0)\n",
+    "    ctrl = C.PlantController(pl, u0, sp, tuning, enabled=enabled, q_stock_meas=qsf, ratio_nom=R0)\n",
+    "    if consigna:\n",
+    "        ctrl = ConsignaVariable(ctrl, consigna)\n",
+    "    return simulate(pl, x0, H, dt, ctrl, disturbance=dist, log_every=log), ctrl\n",
+    "\n",
+    "# %% [markdown]\n",
+    "# ## Parte 1 y 2 · Lazo Abierto vs Lazo Cerrado (Determinista y con Ruido Coloreado)\n",
+    "\n",
+    "# %%\n",
+    "# 1.1 Verificación de reposo estacionario e identificación FOPDT (+/- 10% m_evap)\n",
+    "df0 = lazo_abierto(None, H=6 * 3600, log=60)\n",
+    "assert max(float(np.max(np.abs(df0[k] - df0[k].iloc[0]))) for k in (\"V\", \"T\", \"C\", \"CP\")) < 1e-6\n",
+    "\n",
+    "OL = {n: lazo_abierto(f) for n, f in DIST.items()}\n",
+    "CL = {n: lazo_cerrado(f)[0] for n, f in DIST.items()}\n",
+    "OL_R = {n: lazo_abierto(f) for n, f in DIST_R.items()}\n",
+    "CL_R = {n: lazo_cerrado(f)[0] for n, f in DIST_R.items()}\n",
+    "\n",
+    "# Consistencia modelo-controlador a 24 h (offset nulo por acción integral)\n",
+    "for n in (\"T alim. +5 °C\", \"T alim. -5 °C\", \"Q_stock +10 %\", \"Q_stock -10 %\"):\n",
+    "    f = DIST[n]\n",
+    "    dfc, _ = lazo_cerrado(f, H=24 * 3600, log=60)\n",
+    "    d_end = f(24 * 3600)\n",
+    "    xs, us, ds = pl.steady_state(alpha=0.25, d=d_end, Q_dil=R0 * d_end[\"Q_stock\"])\n",
+    "    ms = pl.metrics(xs, us, ds)\n",
+    "    assert 100.0 * abs(dfc.recovery_pct.iloc[-1] / ms[\"recovery_pct\"] - 1.0) < 0.1\n",
+    "\n",
+    "# %% [markdown]\n",
+    "# ## Parte 3 · Seguimiento de Consignas, Barrido IMC (ε), Ponderación β y Frente de Pareto\n",
+    "\n",
+    "# %%\n",
+    "H_SP = 8 * 3600\n",
+    "K_, tau_, th_ = info[\"T\"][\"K\"], info[\"T\"][\"tau_s\"], max(info[\"T\"][\"theta_s\"], 60.0)\n",
+    "fT_step = lambda t: x0[1] - (2.0 if t >= TP else 0.0)\n",
+    "\n",
+    "# Barrido de filtro IMC (ε) para construir el Frente de Pareto (Variabilidad T vs Esfuerzo m_evap)\n",
+    "pareto_rows = []\n",
+    "for eps_frac in (0.05, 0.10, 0.20, 0.35, 0.60, 1.00):\n",
+    "    tt = imc_pi(K_, tau_, th_, eps_frac * tau_)\n",
+    "    df_p, _ = lazo_cerrado(DIST_R[\"Solo ruido\"], H=H_OL, tuning={**tun, \"T\": tt})\n",
+    "    pareto_rows.append({\n",
+    "        \"eps_tau\": eps_frac,\n",
+    "        \"Kp\": tt.Kp,\n",
+    "        \"sigma_T_C\": sigma_ventana(df_p, \"T\"),\n",
+    "        \"sigma_m_evap_kg_s\": float(df_p.u_m_evap.iloc[len(df_p)//2:].std()),\n",
+    "        \"IAE_T_ruido\": iae(df_p.t_h, df_p[\"T\"] - x0[1]),\n",
+    "    })\n",
+    "df_pareto = pd.DataFrame(pareto_rows)\n",
+    "print(df_pareto.round(4))\n",
+    "\n",
+    "# Análisis de Estabilidad Routh-Hurwitz y Bifurcación de Hopf del lazo de temperatura\n",
+    "rh_info = routh_hopf_analysis(Kp=K_, tau_p=tau_, theta=max(info[\"T\"][\"theta_s\"], 120.0), tau_I=tau_)\n",
+    "print(\"Límites Routh-Hopf lazo T:\", {k: round(v, 4) for k, v in rh_info.items()})\n",
+    "\n",
+    "# %% [markdown]\n",
+    "# ## Parte 4 y Parte B · Acoplamiento NPT-3 (Áreas 2000–3000–6000) y Lazo AIT 3105 + AIC 3255\n",
+    "\n",
+    "# %%\n",
+    "df_osc = simulate_plant_npt3_calibrated(use_AIT3105=True, use_AIC3255=True, tuning_mode=\"ZN_oscillatory\")\n",
+    "df_tl = simulate_plant_npt3_calibrated(use_AIT3105=True, use_AIC3255=True, tuning_mode=\"TL_damped\")\n",
+    "df_hopf = simulate_plant_npt3_calibrated(use_AIT3105=True, use_AIC3255=True, tuning_mode=\"Hopf_limit_cycle\")\n",
+    "\n",
+    "df_sin_AIT = simulate_plant_npt3_calibrated(use_AIT3105=False, use_AIC3255=False, tuning_mode=\"TL_damped\")\n",
+    "df_con_AIT = simulate_plant_npt3_calibrated(use_AIT3105=True, use_AIC3255=False, tuning_mode=\"TL_damped\")\n",
+    "df_con_ambos = simulate_plant_npt3_calibrated(use_AIT3105=True, use_AIC3255=True, tuning_mode=\"TL_damped\")\n",
+    "\n",
+    "print(\"Pico ClO4 producto final Área 6000 SIN AIT 3105:\", round(df_sin_AIT[\"ppm_ClO4_final_6000\"].max(), 2), \"ppm\")\n",
+    "print(\"Pico ClO4 producto final Área 6000 CON AIT 3105:\", round(df_con_AIT[\"ppm_ClO4_final_6000\"].max(), 2), \"ppm\")\n",
+    "print(\"Pico ClO4 producto final Área 6000 CON AIT 3105 + AIC 3255:\", round(df_con_ambos[\"ppm_ClO4_final_6000\"].max(), 2), \"ppm\")"
+   ]
