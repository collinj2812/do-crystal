+    "ax3[0, 1].plot(tl.t_min, tl.P_vac2_bar, \"-\", color=\"tab:blue\", lw=1.8, label=f\"Vacío A3210 PIRCAL 3201 (40 °C); saturado {sat2:.1f} % del tiempo\")\n",
