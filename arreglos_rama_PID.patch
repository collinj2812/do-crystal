+    "# %% [markdown]\n",
+    "# ## Parte 4 (Modo Presentación PPT) · Impresión de Gráficos y Tablas: Estabilidad Routh-Hopf, Cascadas y Perturbaciones con Ruido\n",
+    "\n",
+    "# %%\n",
+    "import os\n",
+    "import numpy as np\n",
+    "import pandas as pd\n",
+    "import matplotlib.pyplot as plt\n",
+    "\n",
+    "os.makedirs(\"../docs/fig\", exist_ok=True)\n",
+    "plt.rcParams.update({\n",
+    "    \"figure.dpi\": 130,\n",
+    "    \"savefig.dpi\": 220,\n",
+    "    \"axes.grid\": True,\n",
+    "    \"grid.alpha\": 0.28,\n",
+    "    \"axes.titlesize\": 10.5,\n",
+    "    \"axes.titleweight\": \"bold\"\n",
+    "})\n",
+    "\n",
+    "# 1. Tabla de Estabilidad Routh-Hurwitz con aproximación de Padé y Bifurcación de Hopf\n",
+    "def routh_hopf_table(Kp, tau_p, theta, tau_I):\n",
+    "    th = max(float(theta), 1e-3)\n",
+    "    a0 = 0.5 * tau_p * tau_I * th\n",
+    "    K_abs = abs(Kp)\n",
+    "    Kc_max = (1.0 / K_abs) * (2.0 * tau_p / th + 1.0)\n",
+    "    grid = np.linspace(1e-4, Kc_max * 0.999, 10000)\n",
+    "    a1 = tau_I * (tau_p + 0.5 * th - 0.5 * grid * K_abs * th)\n",
+    "    a2 = tau_I + grid * K_abs * tau_I - 0.5 * grid * K_abs * th\n",
+    "    a3 = grid * K_abs\n",
+    "    A1 = (a1 * a2 - a0 * a3) / a1\n",
+    "    idx = np.where(A1 <= 0)[0]\n",
+    "    Kc_u = grid[idx[0]] if len(idx) > 0 else Kc_max\n",
+    "    a1_h = tau_I * (tau_p + 0.5 * th - 0.5 * Kc_u * K_abs * th)\n",
+    "    wu = np.sqrt(max((Kc_u * K_abs) / max(a1_h, 1e-9), 1e-9))\n",
+    "    tu = 2.0 * np.pi / wu\n",
+    "    return pd.DataFrame([\n",
+    "        {\"Método / Límite\": \"Bifurcación de Hopf (Ciclo Límite A1=0)\", \"Kc [bar/°C]\": Kc_u, \"tau_I [min]\": tau_I, \"Periodo Pu [min]\": tu, \"Régimen Dinámico\": \"Oscilación Sostenida\"},\n",
+    "        {\"Método / Límite\": \"Ziegler-Nichols (Decaimiento 1/4)\", \"Kc [bar/°C]\": Kc_u / 2.2, \"tau_I [min]\": tu / 1.2, \"Periodo Pu [min]\": tu, \"Régimen Dinámico\": \"Subamortiguado con Overshoot\"},\n",
+    "        {\"Método / Límite\": \"Tyreus-Luyben / IMC (Propuesto)\", \"Kc [bar/°C]\": Kc_u / 3.2, \"tau_I [min]\": 2.2 * tu, \"Periodo Pu [min]\": tu, \"Régimen Dinámico\": \"Fuertemente Amortiguado\"},\n",
+    "    ]).set_index(\"Método / Límite\")\n",
+    "\n",
+    "# Kp = K [K/bar] x Kc_scale = 375 K/bar: ganancia de lazo conservada al recalcular K con vac_T (ver plant.VAC)\n",
+    "tabla_rh = routh_hopf_table(Kp=375.0, tau_p=5.5, theta=1.0, tau_I=3.8)\n",
+    "print(\"=== TABLA 1: LÍMITES DE ESTABILIDAD ROUTH-HURWITZ Y BIFURCACIÓN DE HOPF ===\")\n",
+    "display(tabla_rh.round(4))\n",
+    "\n",
+    "# 1b. Sintonias identificadas SOBRE LA SIMULACION (plant.identificar_Kcu: accion P pura, valvula sin saturar).\n",
+    "# La tabla 1 usa un FOPDT (Kp=375, tau_p=5.5, theta=1) que no reproduce la planta simulada: sus Kc no son los de la simulacion.\n",
+    "from msmpr_core.plant import KCU_SIM, razon_decaimiento, amplitud_oscilacion\n",
+    "Kcu_s, Pu_s = KCU_SIM[\"Kcu_bar_C\"], KCU_SIM[\"Pu_min\"]\n",
+    "filas = [(\"Hopf (Kc = Kcu)\", Kcu_s, Pu_s / 1.2, df_hopf), (\"Ziegler-Nichols PI (0,45 Kcu)\", 0.45 * Kcu_s, Pu_s / 1.2, df_osc),\n",
+    "         (\"Tyreus-Luyben amortiguado (historico)\", 0.0052, 9.5, df_tl)]\n",
+    "tabla_sim = pd.DataFrame([{\"Modo\": n, \"Kc [bar/°C]\": kc, \"Kc/Kcu\": kc / Kcu_s, \"tau_I [min]\": ti,\n",
+    "                           \"Razón de decaimiento (sim.)\": razon_decaimiento(d), \"Amplitud T2 200-300 min [°C]\": amplitud_oscilacion(d, 200, 300)}\n",
+    "                          for n, kc, ti, d in filas]).set_index(\"Modo\")\n",
+    "print(f\"=== TABLA 1b: SINTONÍAS IDENTIFICADAS EN LA SIMULACIÓN (Kcu = {Kcu_s:.5f} bar/°C, Pu = {Pu_s:.2f} min) ===\")\n",
+    "display(tabla_sim.round(4))\n",
+    "\n",
