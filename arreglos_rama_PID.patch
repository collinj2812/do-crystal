+    "ax3[0, 1].set_ylabel(\"Presión de vacío (bar man.)\")\n",
+    "ax3[0, 1].set_title(\"B. Acción de las válvulas de presión (simulación, TL)\")\n",
+    "ax3[0, 1].legend(fontsize=7.2)\n",
+    "\n",
