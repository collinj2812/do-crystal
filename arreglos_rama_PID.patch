+    "# %% [markdown]\n",
+    "# ## Parte 4 (Modo Presentación PPT) · Estabilidad Routh-Hopf, Cascadas Existentes y Rechazo de Ruido\n",
+    "\n",
+    "# %%\n",
+    "import numpy as np\n",
+    "import pandas as pd\n",
+    "import matplotlib.pyplot as plt\n",
+    "from msmpr_core.params import make_params\n",
+    "from msmpr_core.plant import Plant, simulate\n",
+    "from msmpr_core import control as C\n",
+    "\n",
+    "os.makedirs(\"../docs/fig\", exist_ok=True)\n",
+    "p = make_params()\n",
+    "pl = Plant(p)\n",
+    "x0, u0, d0 = pl.steady_state(alpha=0.25)\n",
+    "tun, info = C.autotune(pl, x0, u0, d0, dt_s=5.0)\n",
+    "\n",
+    "# 1. Análisis de Estabilidad Routh-Hurwitz con aproximación de Padé y Bifurcación de Hopf\n",
+    "def routh_hopf_table(Kp, tau_p, theta, tau_I):\n",
+    "    th = max(float(theta), 1e-3)\n",
+    "    a0 = 0.5 * tau_p * tau_I * th\n",
+    "    K_abs = abs(Kp)\n",
+    "    Kc_max = (1.0 / K_abs) * (2.0 * tau_p / th + 1.0)\n",
+    "    grid = np.linspace(1e-4, Kc_max * 0.999, 10000)\n",
+    "    a1 = tau_I * (tau_p + 0.5 * th - 0.5 * grid * K_abs * th)\n",
+    "    a2 = tau_I + grid * K_abs * tau_I - 0.5 * grid * K_abs * th\n",
+    "    a3 = grid * K_abs\n",
+    "    A1 = (a1 * a2 - a0 * a3) / a1\n",
+    "    idx = np.where(A1 <= 0)[0]\n",
+    "    Kc_u = grid[idx[0]] if len(idx) > 0 else Kc_max\n",
+    "    a1_h = tau_I * (tau_p + 0.5 * th - 0.5 * Kc_u * K_abs * th)\n",
+    "    wu = np.sqrt(max((Kc_u * K_abs) / max(a1_h, 1e-9), 1e-9))\n",
+    "    tu = 2.0 * np.pi / wu\n",
+    "    return pd.DataFrame([\n",
+    "        {\"Método / Límite\": \"Bifurcación de Hopf (Ciclo Límite A1=0)\", \"Kc\": Kc_u, \"tau_I [min]\": tau_I, \"Periodo Pu [min]\": tu, \"Régimen Dinámico\": \"Oscilación Sostenida\"},\n",
+    "        {\"Método / Límite\": \"Ziegler-Nichols (Decaimiento 1/4)\", \"Kc\": Kc_u / 2.2, \"tau_I [min]\": tu / 1.2, \"Periodo Pu [min]\": tu, \"Régimen Dinámico\": \"Subamortiguado con Overshoot\"},\n",
+    "        {\"Método / Límite\": \"Tyreus-Luyben (Propuesto Planta)\", \"Kc\": Kc_u / 3.2, \"tau_I [min]\": 2.2 * tu, \"Periodo Pu [min]\": tu, \"Régimen Dinámico\": \"Fuertemente Amortiguado\"},\n",
+    "    ]).set_index(\"Método / Límite\")\n",
+    "\n",
+    "tabla_rh = routh_hopf_table(Kp=375.0, tau_p=5.5, theta=1.0, tau_I=3.8)\n",
+    "display(tabla_rh.round(4))"
+   ]
