+def test_zn_decae_con_razon_cercana_a_un_cuarto(modos):
+    dr = plant.razon_decaimiento(modos["ZN_oscillatory"])
+    assert 0.15 <= dr <= 0.5
+    assert plant.amplitud_oscilacion(modos["ZN_oscillatory"], 200, 300) < 0.05
+
